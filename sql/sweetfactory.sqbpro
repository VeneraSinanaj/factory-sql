INSERT INTO stock (ingredient_id, quantite_disponible, quantite_minimum, quantite_maximum, date_mise_a_jour)
VALUES (24, 320.0,  80.0,  800.0, DATE('now'));

INSERT INTO stock (ingredient_id, quantite_disponible, quantite_minimum, quantite_maximum, date_mise_a_jour)
VALUES (25,  60.0,  25.0,  250.0, DATE('now'));

-- ============================================================
-- RECETTES COMPLÉTÉES AVEC LES NOUVEAUX INGRÉDIENTS
-- Produits qui n'avaient pas de recette ou une recette incomplète
-- ============================================================

-- Produit 1 : Tablette Noir 70% — ajout chocolat noir 70%
INSERT INTO recette (produit_id, ingredient_id, quantite) VALUES (1, 16, 85.0);

