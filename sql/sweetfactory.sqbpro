-- seed_ingredients.sql — Sweet Factory
-- Nouveaux ingrédients, stocks associés et recettes complétées
-- ============================================================

PRAGMA foreign_keys = ON;

-- ============================================================
-- NOUVEAUX INGRÉDIENTS (id 15 → 25)
-- ============================================================

-- Chocolat blanc en pistoles (pour enrobage et ganaches)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (15, 'Chocolat blanc', 'kg', 11.50, 'Barry Callebaut', 'Lactose');

-- Chocolat noir en pistoles 70% (base des tablettes)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (16, 'Chocolat noir 70%', 'kg', 13.20, 'Valrhona', 'Aucun');

-- Chocolat au lait en pistoles
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (17, 'Chocolat au lait', 'kg', 10.80, 'Valrhona', 'Lactose');

-- Crème liquide entière (ganaches, truffes)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (18, 'Crème liquide entière', 'L', 2.40, 'Lactalis', 'Lactose');

-- Praliné noisette (pour pralinés maison et tablettes)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (19, 'Praliné noisette', 'kg', 16.50, 'Olam Nuts', 'Fruits à coque');

-- Sucre glace (glaçages, biscuits)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (20, 'Sucre glace', 'kg', 0.95, 'Cristal Union', 'Aucun');

-- Levure chimique (biscuits et gâteaux)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (21, 'Levure chimique', 'kg', 3.80, 'Lesaffre', 'Gluten');

-- Extrait de framboise naturel (bonbons guimauve)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (22, 'Extrait de framboise', 'kg', 42.00, 'Épices du Monde', 'Aucun');

-- Acide citrique (bonbons acidulés)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (23, 'Acide citrique', 'kg', 5.20, 'Jungbunzlauer', 'Aucun');

-- Amidon de maïs (texture bonbons et biscuits)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (24, 'Amidon de maïs', 'kg', 1.60, 'Roquette', 'Aucun');

-- Huile de coco (enrobage, texture)
INSERT INTO ingredient (id, nom, unite, prix_unitaire, fournisseur, allergene)
VALUES (25, 'Huile de coco', 'kg', 6.90, 'Jardin Bio', 'Aucun');

-- ============================================================
-- STOCKS DES NOUVEAUX INGRÉDIENTS
-- ============================================================

INSERT INTO stock (ingredient_id, quantite_disponible, quantite_minimum, quantite_maximum, date_mise_a_jour)
VALUES (15, 120.0,  40.0,  500.0, DATE('now'));

